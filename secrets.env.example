# =============================================================================
# Project Masquerade Scraper · SECRETS / CONFIG  (EXAMPLE — copy to secrets.env)
# -----------------------------------------------------------------------------
#   cp secrets.env.example secrets.env    then fill in the values below.
#   secrets.env is gitignored — never commit it, and never commit your key JSON.
#
#   Load in shell:   set -a; source secrets.env; set +a
#   (the Python scripts also read secrets.env directly, so sourcing is optional)
# =============================================================================

# --- Google Sheets service account  (REQUIRED — read + write) ----------------
# 1. GCP console → create a service account → create a JSON key → download it.
# 2. Enable the Google Sheets API for that project.
# 3. Share your spreadsheet with the service account's e-mail (…@….iam.gserviceaccount.com)
#    as an Editor.
# 4. Put the JSON key anywhere gitignored (repo root is fine) and point to it here.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Target spreadsheet  (REQUIRED) ------------------------------------------
# The id in the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=PASTE_YOUR_SPREADSHEET_ID_HERE

# --- ScrapeCreators  (OPTIONAL — paid-API fallback for TikTok/Instagram) -----
# The CDP scrapers in scrape/ are free and preferred; this is only a fallback.
# Sent as HTTP header:  x-api-key: <value>   ·   https://app.scrapecreators.com
SCRAPECREATORS_API_KEY=PASTE_SCRAPECREATORS_KEY_HERE

# --- Bright Data  (OPTIONAL — paid-API fallback for YouTube) ------------------
# Sent as HTTP header:  Authorization: Bearer <value>   ·   https://brightdata.com
BRIGHTDATA_API_TOKEN=PASTE_BRIGHTDATA_TOKEN_HERE
